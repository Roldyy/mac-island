<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Lane W4C: hardened runtime refuses the camera (the preview mirror) without this entitlement. -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <!-- Hardened runtime: AppleScript to Finder, Spotify and Music needs this entitlement. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <!-- Lane W4B (screen recorder): the hardened runtime blocks microphone capture without this entitlement.
         Only the microphone recording of the recorder uses it; macOS still asks (NSMicrophoneUsageDescription). -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Calendar (island calendar, Google accounts added in System Settings): the hardened runtime refuses EventKit
         access without this entitlement; macOS still asks (NSCalendarsFullAccessUsageDescription). -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
    <!-- Bluetooth sleep restore: CoreBluetooth/IOBluetooth need this under the hardened runtime (and a usage string). -->
    <key>com.apple.security.device.bluetooth</key>
    <true/>
    <!-- Wi-Fi name in the Network chip: macOS hides the SSID until the app may use Location (CoreLocation asks once,
         when the chip first runs on Wi-Fi; NSLocationWhenInUseUsageDescription). The key name is to be checked after
         a signed install with codesign and its entitlements option. -->
    <key>com.apple.security.personal-information.location</key>
    <true/>
</dict>
</plist>
