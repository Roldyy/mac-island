<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Packaging: copy to "Mac Island.app/Contents/Library/LaunchDaemons/be.roldy.macisland.fanhelper.plist"
  and the FanHelper binary to "Mac Island.app/Contents/MacOS/FanHelper".
  Sign the helper first with identifier be.roldy.macisland.fanhelper, then the app (no deep signing).
  The app registers it with SMAppService.daemon(plistName:) on an explicit click only.
  Not strictly on demand: KeepAlive {SuccessfulExit = false} implies a start at load, so once the
  user approved it launchd starts the helper and keeps the idle helper alive. If it crashes or is
  SIGKILLed with a fan left manual, launchd relaunches it (ThrottleInterval: at most every 10 s)
  and its startup recovery restores automatic without the app. A clean exit (code 0, e.g. after
  SIGTERM) is not restarted.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>be.roldy.macisland.fanhelper</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/FanHelper</string>
	<key>MachServices</key>
	<dict>
		<key>be.roldy.macisland.fanhelper</key>
		<true/>
	</dict>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>be.roldy.macisland</string>
	</array>
</dict>
</plist>
