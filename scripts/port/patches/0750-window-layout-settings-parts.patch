 import SwiftUI
 
+/// One half of the Window Layout page. Mac Island shows each on its own Settings page.
+enum WindowLayoutSettingsPart: Hashable {
+    case layout, maximizer
+}
+
+/// Mac Island: `WindowLayoutSettings(parts:)` shows only the named half (placement for `.layout`, the green button
+/// for `.maximizer`) and shows it even while the registry holds the feature off, so its settings stay reachable
+/// (the page opens with the feature's own card and switch). nil: the whole upstream page.
 struct WindowLayoutSettings: View {
+    let parts: Set<WindowLayoutSettingsPart>?
+
+    init(parts: Set<WindowLayoutSettingsPart>? = nil) { self.parts = parts }
+
+    private var showsLayout: Bool {
+        if let parts { return parts.contains(.layout) }
+        return AppFeature.windowLayout.isAvailable
+    }
+
+    private var showsMaximizer: Bool {
+        if let parts { return parts.contains(.maximizer) }
+        return AppFeature.windowMaximizer.isAvailable
+    }
+
