 import SwiftUI

+/// One card (or group of rows) of the Mouse & Trackpad page. Mac Island shows each on its own Settings page.
+enum MouseSettingsPart: Hashable {
+    case scrollDirection, horizontalScroll, focusFollowsMouse, smoothScroll, linearScroll, acceleration,
+         navigation, buttonShortcuts, clickDebounce, middleClick
+}
+
 /// The Mouse & Trackpad page: a legend of every mouse feature and whether it
 /// is on, each one a click away from its card, then one card per feature.
+///
+/// Mac Island: `MouseSettings(parts:)` shows only the named cards, with no title, legend, scroll view or
+/// permission note (the host page has its own), and shows them even while the registry holds the feature
+/// off, so its switch and settings stay reachable.
 struct MouseSettings: View {
+    /// nil: the whole upstream page. A set: only those parts, for a page of its own.
+    let parts: Set<MouseSettingsPart>?
+
+    init(parts: Set<MouseSettingsPart>? = nil) { self.parts = parts }
+
+    private func shows(_ part: MouseSettingsPart, _ feature: AppFeature) -> Bool {
+        if let parts { return parts.contains(part) }
+        return feature.isAvailable
+    }
+
