+    /// Mac Island: the closed-lid safety policy (`ClamshellSafetyPolicy`: battery under 20 % unplugged, a hot Mac,
+    /// a duration cap). A violation ends the closed-lid mode only (the keep-awake session itself goes on) and
+    /// turns the preference off, so it takes a new click to start it again.
+    func checkClamshellSafety(now: Date = Date()) {
+        guard clamshellActive, let violation = currentClamshellViolation(activeSince: clamshellActiveSince, now: now)
+        else { return }
+        clamshellStopReason = violation
+        clamshellPreferred = false
+    }
+
+    private func currentClamshellViolation(activeSince: Date?, now: Date) -> ClamshellSafetyPolicy.Violation? {
+        let battery = SystemInfo.batterySnapshot()
+        return ClamshellSafetyPolicy.violation(onBattery: battery?.isOnBattery ?? false,
+                                               batteryPercent: battery?.percent,
+                                               thermalState: ProcessInfo.processInfo.thermalState,
+                                               activeSince: activeSince, now: now)
+    }
