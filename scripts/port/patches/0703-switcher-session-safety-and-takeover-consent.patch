     private func cancelSession() {
         guard sessionActive else { return }
         endSession()
+    }
+
+    /// A session left open (a key never released, a lost event, a modal that took the keyboard) must not keep the
+    /// overlay up and the keys swallowed: it closes after `SwitcherSessionSafety.idleTimeout` without input, and the
+    /// moment another app becomes frontmost. Escape and a click outside are handled by the tap itself.
+    private func beginSessionSafety(frontPID: pid_t) {
+        sessionFrontPID = frontPID
+        armSessionWatchdog()
+        guard sessionActivationObserver == nil else { return }
+        sessionActivationObserver = NSWorkspace.shared.notificationCenter.addObserver(
+            forName: NSWorkspace.didActivateApplicationNotification, object: nil, queue: .main
+        ) { [weak self] note in
+            guard let self, self.sessionActive else { return }
+            let app = note.userInfo?[NSWorkspace.applicationUserInfoKey] as? NSRunningApplication
+            if SwitcherSessionSafety.shouldCancelOnActivation(activatedPID: app?.processIdentifier,
+                                                              sessionFrontPID: self.sessionFrontPID) {
+                self.cancelSession()
+            }
+        }
+    }
+
+    private func armSessionWatchdog() {
+        sessionWatchdog.arm { [weak self] in
+            guard let self, self.sessionActive else { return }
+            self.cancelSession()
+        }
     }
 
+    private func endSessionSafety() {
+        sessionWatchdog.disarm()
+        if let sessionActivationObserver {
+            NSWorkspace.shared.notificationCenter.removeObserver(sessionActivationObserver)
+        }
+        sessionActivationObserver = nil
+        sessionFrontPID = nil
+    }
+
     private func endSession() {
+        endSessionSafety()
         stopObservingTermination()
         cancelLetterConfirmation()
         SwitcherAppIconCache.endSession()
